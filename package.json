{
  "name": "tanstack-start-example-basic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "shopify app dev --use-localhost",
    "app:dev": "vite dev",
    "app:build": "vite build && tsc --noEmit",
    "app:start": "node .output/server/index.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "graphql:generate": "graphql-codegen",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "packageManager": "pnpm@10.18.0",
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "dependencies": {
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/app-bridge-react": "^4.2.8",
    "@shopify/shopify-api": "^12.2.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.141.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-router-devtools": "^1.141.2",
    "@tanstack/react-start": "^1.141.3",
    "bullmq": "^5.66.0",
    "drizzle-orm": "^0.45.1",
    "graphql-config": "^5.1.5",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@shopify/api-codegen-preset": "^1.2.1",
    "@shopify/app-bridge-types": "^0.5.3",
    "@shopify/polaris-types": "^1.0.1",
    "@tanstack/eslint-config": "^0.3.4",
    "@tanstack/react-router-ssr-query": "^1.141.2",
    "@types/node": "^25.0.1",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
