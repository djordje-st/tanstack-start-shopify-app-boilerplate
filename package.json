{
  "name": "tanstack-start-shopify-app-boilerplate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "shopify app dev",
    "app:dev": "vite dev",
    "app:build": "vite build && tsc --noEmit",
    "app:start": "node .output/server/index.mjs",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "graphql:watch": "graphql-codegen --watch",
    "graphql:generate": "graphql-codegen",
    "graphql:generate:admin": "graphql-codegen --project=default",
    "graphql:generate:storefront": "graphql-codegen --project=storefront",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:destroy": "docker compose down -v",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "dependencies": {
    "@shopify/app-bridge-react": "^4.2.10",
    "@shopify/shopify-api": "^12.3.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.154.7",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.161.3",
    "@tanstack/react-start": "^1.161.3",
    "bullmq": "^5.67.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-uncache": "^1.0.0",
    "drizzle-zod": "^0.8.3",
    "graphql-config": "^5.1.5",
    "ioredis": "^5.9.2",
    "isbot": "^5.1.35",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "unstorage": "^1.17.4",
    "vite": "^7.3.1",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@shopify/admin-api-client": "^1.1.1",
    "@shopify/api-codegen-preset": "^1.2.2",
    "@shopify/app-bridge-types": "^0.7.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "@shopify/polaris-types": "^1.0.1",
    "@shopify/storefront-api-client": "^1.0.9",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-router-ssr-query": "^1.161.3",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
