{
  "name": "tanstack-start-shopify-app-boilerplate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "shopify app dev",
    "app:dev": "vite dev",
    "app:build": "vite build && tsc --noEmit",
    "app:start": "node .output/server/index.mjs",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "graphql:watch": "graphql-codegen --watch",
    "graphql:generate": "graphql-codegen",
    "graphql:generate:admin": "graphql-codegen --project=default",
    "graphql:generate:storefront": "graphql-codegen --project=storefront",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:destroy": "docker compose down -v",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "dependencies": {
    "@shopify/app-bridge-react": "^4.2.10",
    "@shopify/shopify-api": "^13.0.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.154.9",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-router": "^1.168.10",
    "@tanstack/react-start": "^1.167.16",
    "bullmq": "^5.73.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-uncache": "^1.0.0",
    "drizzle-zod": "^0.8.3",
    "graphql-config": "^5.1.6",
    "ioredis": "^5.10.1",
    "isbot": "^5.1.37",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "unstorage": "^1.17.5",
    "vite": "^8.0.3",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@shopify/admin-api-client": "^1.1.2",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/app-bridge-types": "^0.7.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "@shopify/polaris-types": "^1.0.1",
    "@shopify/storefront-api-client": "^1.0.10",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/react-router-ssr-query": "^1.166.10",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
